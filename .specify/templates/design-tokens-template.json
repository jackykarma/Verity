{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_comment": "Design Token 模板 — 从 Figma/Sketch 等设计工具导出，或由设计师手动填写。可选输入：无此文件时仍可解析设计稿，数值由截图推测或 design-notes §一 兜底。若有此文件，AI 将其作为精确视觉规范的权威来源。存放位置：design/design-tokens.json",
  "color": {
    "primary": {
      "$value": "#1976D2",
      "$type": "color",
      "$description": "主色"
    },
    "onPrimary": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "主色上的文字/图标"
    },
    "primaryContainer": {
      "$value": "#E3F2FD",
      "$type": "color",
      "$description": "主色容器"
    },
    "secondary": {
      "$value": "#388E3C",
      "$type": "color",
      "$description": "辅色"
    },
    "background": {
      "$value": "#FAFAFA",
      "$type": "color",
      "$description": "背景色"
    },
    "surface": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "表面色"
    },
    "error": {
      "$value": "#D32F2F",
      "$type": "color",
      "$description": "错误色"
    },
    "_dark": {
      "$description": "Dark Mode 色值（若支持）",
      "primary": { "$value": "#90CAF9", "$type": "color" },
      "onPrimary": { "$value": "#1565C0", "$type": "color" },
      "background": { "$value": "#121212", "$type": "color" },
      "surface": { "$value": "#1E1E1E", "$type": "color" }
    }
  },
  "spacing": {
    "$description": "间距规范（单位 dp）",
    "xs": { "$value": "4", "$type": "dimension" },
    "sm": { "$value": "8", "$type": "dimension" },
    "md": { "$value": "16", "$type": "dimension" },
    "lg": { "$value": "24", "$type": "dimension" },
    "xl": { "$value": "32", "$type": "dimension" }
  },
  "borderRadius": {
    "$description": "圆角规范（单位 dp）",
    "small": { "$value": "4", "$type": "dimension" },
    "medium": { "$value": "8", "$type": "dimension" },
    "large": { "$value": "12", "$type": "dimension" },
    "extraLarge": { "$value": "28", "$type": "dimension" },
    "full": { "$value": "9999", "$type": "dimension", "$description": "全圆角/胶囊形" }
  },
  "typography": {
    "displayLarge": {
      "$description": "大标题",
      "fontSize": { "$value": "57", "$type": "dimension" },
      "lineHeight": { "$value": "64", "$type": "dimension" },
      "fontWeight": { "$value": "400", "$type": "fontWeight" },
      "fontFamily": { "$value": "Roboto", "$type": "fontFamily" }
    },
    "headlineMedium": {
      "$description": "中标题",
      "fontSize": { "$value": "28", "$type": "dimension" },
      "lineHeight": { "$value": "36", "$type": "dimension" },
      "fontWeight": { "$value": "400", "$type": "fontWeight" }
    },
    "titleLarge": {
      "$description": "页面标题",
      "fontSize": { "$value": "22", "$type": "dimension" },
      "lineHeight": { "$value": "28", "$type": "dimension" },
      "fontWeight": { "$value": "400", "$type": "fontWeight" }
    },
    "bodyLarge": {
      "$description": "正文大",
      "fontSize": { "$value": "16", "$type": "dimension" },
      "lineHeight": { "$value": "24", "$type": "dimension" },
      "fontWeight": { "$value": "400", "$type": "fontWeight" }
    },
    "bodyMedium": {
      "$description": "正文",
      "fontSize": { "$value": "14", "$type": "dimension" },
      "lineHeight": { "$value": "20", "$type": "dimension" },
      "fontWeight": { "$value": "400", "$type": "fontWeight" }
    },
    "labelMedium": {
      "$description": "标签",
      "fontSize": { "$value": "12", "$type": "dimension" },
      "lineHeight": { "$value": "16", "$type": "dimension" },
      "fontWeight": { "$value": "500", "$type": "fontWeight" }
    }
  },
  "elevation": {
    "$description": "高程/阴影（单位 dp）",
    "level0": { "$value": "0", "$type": "dimension" },
    "level1": { "$value": "1", "$type": "dimension" },
    "level2": { "$value": "3", "$type": "dimension" },
    "level3": { "$value": "6", "$type": "dimension" },
    "level4": { "$value": "8", "$type": "dimension" },
    "level5": { "$value": "12", "$type": "dimension" }
  }
}
